# 数据库配置
MONGODB_URI=mongodb://localhost:27017/wwzhidao
DB_TYPE=mongodb

# JWT 配置
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=8888
NODE_ENV=development

# 从 URL 下载简历等文件时，若出现 "unable to get local issuer certificate"，可设以下为 true（仅开发/内网建议）
SKIP_SSL_VERIFY_FOR_DOWNLOAD=false

# 面试押题生成的问题数量（默认 10，范围 6-16）
# RESUME_QUIZ_QUESTION_COUNT=10

# ========== AI 配置（默认使用 DeepSeek） ==========
# 提供商：deepseek（默认）| openai
LLM_PROVIDER=deepseek

# --- DeepSeek，默认使用 ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4000

# --- OpenAI (GPT)，当 LLM_PROVIDER=openai 时使用 ---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=4000

# --- 本地 Mock 用户（可选，与前端约定一致即可）---
# MOCK_USER_ID=mock_local_user_001
# MOCK_USERNAME=本地Mock用户
# MOCK_EMAIL=mock@local.dev
