# 本地开发优先读取此文件：
# .env.local > .env.development > .env.production > .env

PORT=8888
NODE_ENV=development

# 本地 MongoDB。可配合 docker-compose.local.yml 使用
MONGODB_URI=mongodb://localhost:27017/wwzhidao

# JWT
JWT_SECRET=local-dev-secret
JWT_EXPIRES_IN=24h

# 选择一个可用的模型提供商
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4000

# 如果要改用 OpenAI，改 LLM_PROVIDER=openai，并填写以下配置
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=4000

# 本地 Mock 用户（与前端开发环境的 mock 登录保持一致）
MOCK_USER_ID=mock_local_user_001
MOCK_USERNAME=本地Mock用户
MOCK_EMAIL=mock@local.dev
